# Copy to .env and fill in the keys for the providers you want to use.
# Agents whose key is missing simply can't be created; the rest work fine.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...
XAI_API_KEY=xai-...
DASHSCOPE_API_KEY=sk-...
PPLX_API_KEY=pplx-...
MOONSHOT_API_KEY=sk-...
ARK_API_KEY=...
# fal.ai: OpenRouter gateway for the fal-hosted characters (Gemini, Qwen, Kimi, Doubao),
# and the replay's voices, sound effects and art (MiniMax / ByteDance Seed TTS, ElevenLabs, image models).
# The backend's voice and banter scripts read this file too.
FAL_KEY=...
